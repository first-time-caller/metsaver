<Window x:Class="MetSaver.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MetSaver settings" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Label"><Setter Property="Padding" Value="0,6,16,6"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,3"/><Setter Property="MinWidth" Value="220"/></Style>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="3"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,5"/><Setter Property="Margin" Value="4,0,0,0"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,3"/></Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="MetSaver" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="Public-domain paintings from The Metropolitan Museum of Art" Foreground="Gray" Margin="0,0,0,14"/>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Start after idle (seconds)"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="IdleBox" Width="80" HorizontalAlignment="Left"/>

            <Label Grid.Row="1" Content="Seconds per painting"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="SecondsBox" Width="80" HorizontalAlignment="Left"/>

            <Label Grid.Row="2" Content="Painting size"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="FillBox">
                <ComboBoxItem Content="Fill the screen (crops edges)"/>
                <ComboBoxItem Content="Whole painting on a mat"/>
            </ComboBox>

            <Label Grid.Row="3" Content="Shape match"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                <Slider x:Name="StrictSlider" Minimum="0.5" Maximum="0.95" Width="170" VerticalAlignment="Center"
                        ToolTip="Higher = fewer paintings qualify, but less cropping"/>
                <TextBlock x:Name="StrictLabel" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
            </StackPanel>

            <Label Grid.Row="4" Content="Motion"/>
            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="MotionBox">
                <ComboBoxItem Content="Off (still)"/>
                <ComboBoxItem Content="Subtle drift"/>
                <ComboBoxItem Content="Ken Burns (zoom + pan)"/>
            </ComboBox>

            <Label Grid.Row="5" Content="Info card"/>
            <CheckBox Grid.Row="5" Grid.Column="1" x:Name="CaptionCheck" Content="Show title, artist and medium" VerticalAlignment="Center"/>

            <Label Grid.Row="6" Content="Info card corner"/>
            <ComboBox Grid.Row="6" Grid.Column="1" x:Name="CornerBox">
                <ComboBoxItem Content="top-left"/><ComboBoxItem Content="top-right"/>
                <ComboBoxItem Content="bottom-left"/><ComboBoxItem Content="bottom-right"/>
            </ComboBox>

            <Label Grid.Row="7" Content="Hide card after (s, 0 = never)"/>
            <TextBox Grid.Row="7" Grid.Column="1" x:Name="HideBox" Width="80" HorizontalAlignment="Left"/>

            <Label Grid.Row="8" Content="Collections"/>
            <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,3">
                <CheckBox x:Name="Dept11" Content="European Paintings"/>
                <CheckBox x:Name="Dept1" Content="American Paintings"/>
                <CheckBox x:Name="Dept21" Content="Modern &amp; Contemporary (few)"/>
                <CheckBox x:Name="Dept6" Content="Asian Art (scrolls and screens; a narrow match)"/>
            </StackPanel>

            <Label Grid.Row="9" Content="Search themes (live mode)"/>
            <TextBox Grid.Row="9" Grid.Column="1" x:Name="TermsBox" Width="330" ToolTip="Comma separated"/>

            <Label Grid.Row="10" Content="Smart features"/>
            <StackPanel Grid.Row="10" Grid.Column="1" Margin="0,3">
                <CheckBox x:Name="MoodCheck" Content="Match the hour and season (night scenes at night, snow in winter)"/>
                <CheckBox x:Name="CropCheck" Content="Crop toward the interesting part of each painting"/>
                <CheckBox x:Name="AmbientCheck" Content="Dim with room light or the clock; calmer motion on battery"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="Status" Foreground="#2a6" Margin="0,12,0,0" TextWrapping="Wrap" MaxWidth="460"/>

        <Grid Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Set as my screensaver" Click="OnInstall" Margin="0"/>
                <Button Content="Restore previous" Click="OnRestore"/>
                <Button Content="Open gallery (keyboard)" Click="OnGallery"/>
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Test window" Click="OnTest"/>
            <Button Content="Clear history" Click="OnClearHistory"/>
            <Button Content="Save" Click="OnSave" IsDefault="True"/>
            <Button Content="Cancel" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
